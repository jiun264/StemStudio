<Window x:Class="StemStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StemStudio - AI 樂曲分軌"
        Width="900"
        Height="760"
        MinWidth="700"
        MinHeight="650"
        Background="#10151D"
        Foreground="#F3F5F8"
        FontFamily="Segoe UI"
        AllowDrop="True"
        Loaded="Window_Loaded"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1A222E" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A7B2C2" />
        <SolidColorBrush x:Key="AccentBrush" Color="#65D6B1" />
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F3F5F8" />
            <Setter Property="Background" Value="#293444" />
            <Setter Property="BorderBrush" Value="#39485A" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F3F5F8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,20,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock FontSize="30" FontWeight="Bold" Text="StemStudio" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="14"
                       Text="在你的電腦上分離人聲、吉他、貝斯與鼓" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="20"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#2B3848"
                BorderThickness="1"
                CornerRadius="12">
            <StackPanel>
                <DockPanel Margin="0,0,0,14" LastChildFill="False">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="1. 加入音訊檔案" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="RemoveButton"
                                Click="RemoveButton_Click"
                                Content="移除選取"
                                IsEnabled="False" />
                        <Button x:Name="BrowseButton" Click="BrowseButton_Click" Content="選擇檔案" />
                    </StackPanel>
                </DockPanel>
                <Border Padding="12"
                        Background="#121923"
                        BorderBrush="#334458"
                        BorderThickness="1"
                        CornerRadius="8">
                    <ListBox x:Name="FileList"
                             Height="146"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#F3F5F8"
                             SelectionChanged="FileList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Padding="8,7" Text="{Binding}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <TextBlock Margin="2,10,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           Text="也可以將音訊檔拖放到這裡；支援 WAV、MP3、FLAC、M4A、OGG、WMA、AAC。" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,18,0,18"
                Padding="20"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#2B3848"
                BorderThickness="1"
                CornerRadius="12">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="2. 選擇要輸出的音軌" />
                <TextBlock Margin="0,6,0,18"
                           Foreground="{StaticResource MutedBrush}"
                           Text="分離模型會計算多種音軌，最後只保留你勾選的項目。" />
                <WrapPanel x:Name="StemOptions">
                    <CheckBox x:Name="VocalsCheckBox" Content="人聲" IsChecked="True" />
                    <CheckBox x:Name="GuitarCheckBox" Content="吉他" IsChecked="True" />
                    <CheckBox x:Name="BassCheckBox" Content="貝斯" IsChecked="True" />
                    <CheckBox x:Name="DrumsCheckBox" Content="鼓" IsChecked="True" />
                </WrapPanel>
                <Border Margin="0,28,0,0"
                        Padding="14"
                        Background="#121923"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock x:Name="StatusText"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="尚未開始。分軌結果會儲存在「音樂\StemStudio」資料夾。" />
                        <ProgressBar x:Name="ProgressIndicator"
                                     Height="4"
                                     Margin="0,12,0,0"
                                     Background="#293444"
                                     Foreground="{StaticResource AccentBrush}"
                                     IsIndeterminate="False"
                                     Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="3" LastChildFill="False">
            <TextBlock VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"
                       Text="模型：Demucs htdemucs_6s · 本機處理" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="SettingsButton"
                        Click="SettingsButton_Click"
                        Content="設定" />
                <Button x:Name="CancelButton"
                        Click="CancelButton_Click"
                        Content="取消"
                        IsEnabled="False" />
                <Button x:Name="SeparateButton"
                        Click="SeparateButton_Click"
                        Background="#27866D"
                        BorderBrush="#27866D"
                        FontWeight="SemiBold"
                        Content="開始分軌" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
